  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "-I",
              "-S",
              "-B",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verificar_identidad_farmatic.py"
            ],
            "timeout": 30,
            "statusMessage": "Verificando identidad antes de acceder a Farmatic"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "-I",
              "-S",
              "-B",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/barreras_agentes.py"
            ],
            "timeout": 30,
            "statusMessage": "Aplicando barreras de agentes"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/notificar.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "-I",
              "-S",
              "-B",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/registrar_uso_agente.py"
            ],
            "timeout": 60,
            "statusMessage": "Registrando uso del subagente"
          }
        ]
      }
    ]
  }
}
