{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["facturas"],
  "properties": {
    "facturas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo_documento",
          "naturaleza_principal",
          "requiere_conciliacion_albaranes",
          "pagina_inicio",
          "pagina_fin",
          "proveedor_nombre",
          "proveedor_cif",
          "numero_factura",
          "fecha_factura",
          "base_imponible_total",
          "iva_total",
          "recargo_equivalencia_total",
          "importe_total",
          "vencimientos",
          "impuestos",
          "albaranes",
          "movimientos_comerciales",
          "destinatario",
          "forma_pago",
          "discrepancias_documentales"
        ],
        "properties": {
          "tipo_documento": {"type": ["string", "null"]},
          "naturaleza_principal": {
            "anyOf": [
              {"type": "string", "enum": ["CARGO", "ABONO", "MIXTO", "OTRO"]},
              {"type": "null"}
            ]
          },
          "requiere_conciliacion_albaranes": {"type": ["boolean", "null"]},
          "pagina_inicio": {"type": ["integer", "null"], "minimum": 1},
          "pagina_fin": {"type": ["integer", "null"], "minimum": 1},
          "proveedor_nombre": {"type": ["string", "null"]},
          "proveedor_cif": {"type": ["string", "null"]},
          "numero_factura": {"type": ["string", "null"]},
          "fecha_factura": {"type": ["string", "null"]},
          "base_imponible_total": {"type": ["number", "null"]},
          "iva_total": {"type": ["number", "null"]},
          "recargo_equivalencia_total": {"type": ["number", "null"]},
          "importe_total": {"type": ["number", "null"]},
          "vencimientos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["orden", "fecha", "importe"],
              "properties": {
                "orden": {"type": "integer", "minimum": 1},
                "fecha": {"type": ["string", "null"]},
                "importe": {"type": ["number", "null"]}
              }
            }
          },
          "impuestos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["orden", "base", "tipo_iva", "cuota_iva", "tipo_recargo_equivalencia", "cuota_recargo_equivalencia"],
              "properties": {
                "orden": {"type": "integer", "minimum": 1},
                "base": {"type": ["number", "null"]},
                "tipo_iva": {"type": ["number", "null"]},
                "cuota_iva": {"type": ["number", "null"]},
                "tipo_recargo_equivalencia": {"type": ["number", "null"]},
                "cuota_recargo_equivalencia": {"type": ["number", "null"]}
              }
            }
          },
          "albaranes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["orden", "fecha", "numero", "naturaleza", "tipo_pedido", "importe_base", "importe_total"],
              "properties": {
                "orden": {"type": "integer", "minimum": 1},
                "fecha": {"type": ["string", "null"]},
                "numero": {"type": ["string", "null"]},
                "naturaleza": {
                  "anyOf": [
                    {"type": "string", "enum": ["CARGO", "ABONO"]},
                    {"type": "null"}
                  ]
                },
                "tipo_pedido": {"type": ["string", "null"]},
                "importe_base": {"type": ["number", "null"]},
                "importe_total": {"type": ["number", "null"]}
              }
            }
          },
          "movimientos_comerciales": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["orden", "tipo", "descripcion_literal", "sentido", "base", "iva", "recargo_equivalencia", "importe"],
              "properties": {
                "orden": {"type": "integer", "minimum": 1},
                "tipo": {
                  "type": "string",
                  "enum": ["RAPPEL", "ABONO_COMERCIAL", "DEVOLUCION_MERCANCIA", "DESCUENTO", "BONIFICACION", "SERVICIO", "CONDICION_COMERCIAL", "OTRO"]
                },
                "descripcion_literal": {"type": ["string", "null"]},
                "sentido": {
                  "anyOf": [
                    {"type": "string", "enum": ["ABONO", "CARGO"]},
                    {"type": "null"}
                  ]
                },
                "base": {"type": ["number", "null"]},
                "iva": {"type": ["number", "null"]},
                "recargo_equivalencia": {"type": ["number", "null"]},
                "importe": {"type": ["number", "null"]}
              }
            }
          },
          "destinatario": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["nombre", "cif", "direccion"],
                "properties": {
                  "nombre": {"type": ["string", "null"]},
                  "cif": {"type": ["string", "null"]},
                  "direccion": {"type": ["string", "null"]}
                }
              },
              {"type": "null"}
            ]
          },
          "forma_pago": {"type": ["string", "null"]},
          "discrepancias_documentales": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["campo", "valores_literales", "descripcion_literal"],
              "properties": {
                "campo": {"type": ["string", "null"]},
                "valores_literales": {"type": "array", "items": {"type": "string"}},
                "descripcion_literal": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
